# Peak Hydration — Apache config for Hostinger
# Security + performance defaults

# Disable directory listing
Options -Indexes

# Enable clean error behaviour
ErrorDocument 404 /404.html

# Cache static assets (images, css, js)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# Protect the Instagram token and its cache.
# PHP is normally executed rather than served, but if PHP were ever disabled
# the config would be readable as plain text — this closes that window.
<FilesMatch "^instagram-config(\.sample)?\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^cache/ - [F,L]
</IfModule>

# Video should stream and seek — Range requests must be allowed
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm)$">
    Header set Accept-Ranges "bytes"
  </FilesMatch>
</IfModule>
